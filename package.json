{
  "name": "dsh-plugin-01-wallpaper",
  "version": "0.9.0",
  "description": "零一·凌界｜零一 AI 日新社专属 DSH 黑白机械终端主题，含动态数据雨与桌面入场衔接",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "LICENSE",
    "docs/screenshots"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "start": "node scripts/preview.mjs",
    "build": "node scripts/build.mjs",
    "check": "node --check src/wallpaper.js && node --check src/client.js && node --check lib/client.js"
  },
  "engines": {
    "node": ">=22.19"
  },
  "private": true,
  "meta": {
    "title": "零一·凌界",
    "description": "零一 AI 日新社 · 黑白机械终端主题"
  },
  "author": "零一 AI 日新社",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiaoSiKe/zero-one-lingjie-theme.git"
  },
  "homepage": "https://github.com/XiaoSiKe/zero-one-lingjie-theme#readme",
  "bugs": {
    "url": "https://github.com/XiaoSiKe/zero-one-lingjie-theme/issues"
  }
}
